# Public base URL used in signed download links (no trailing slash).
UNFAIRPLAY_BOT_PUBLIC_URL=https://ipa.example.com
# openssl rand -hex 32
UNFAIRPLAY_BOT_API_TOKEN=
# openssl rand -hex 32 (changing it invalidates every issued link)
UNFAIRPLAY_BOT_SIGNING_KEY=
# Passphrase you chose for `ipatool auth login --keychain-passphrase`.
UNFAIRPLAY_BOT_KEYCHAIN_PASSPHRASE=

# Telegram bot (leave the token empty to run the HTTP API only).
UNFAIRPLAY_BOT_TELEGRAM_TOKEN=
# Your Telegram user ID(s), comma separated. Admins can always use the bot,
# manage the allowlist, and get notices about everyone else's requests.
UNFAIRPLAY_BOT_TELEGRAM_ADMIN_IDS=
# UNFAIRPLAY_BOT_TELEGRAM_API_URL=https://api.telegram.org

# Country of the Apple Account's storefront, for app names/sizes in previews.
UNFAIRPLAY_BOT_STORE_COUNTRY=us
# Time zone for times shown in Telegram.
TZ=Asia/Shanghai

# Optional (defaults shown).
# UNFAIRPLAY_BOT_PURCHASE=true            # acquire licenses for free apps
# UNFAIRPLAY_BOT_CONCURRENCY=3            # tasks running at once
# UNFAIRPLAY_BOT_DECRYPT_CONCURRENCY=1    # of those, decrypting at once
# UNFAIRPLAY_BOT_MAX_QUEUE=100            # tasks waiting beyond the running ones
# UNFAIRPLAY_BOT_CACHE_TTL=24h            # sliding: extended by every hit
# UNFAIRPLAY_BOT_MAX_CACHE_BYTES=0        # 0 = no cap; otherwise LRU eviction
# UNFAIRPLAY_BOT_TASK_TIMEOUT=60m
# UNFAIRPLAY_BOT_TASK_RETENTION=1h        # how long finished tasks stay queryable
# UNFAIRPLAY_BOT_DRAIN_TIMEOUT=30m        # graceful shutdown wait for tasks
