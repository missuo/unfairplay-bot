# Dependency tracking, read by scripts/update-deps.sh and the Dockerfile build.
#
# Policy per dependency:
#   main        newest commit on the default branch
#   release     newest stable release tag
#   prerelease  newest tag, including release candidates
#
# The ipatool version itself is pinned in go.mod (it is linked as a library;
# the ipatool CLI in the image is built from the same version).
IPATOOL_TRACK=main
UNFAIRPLAY_TRACK=main
UNFAIRPLAY_VERSION=v0.2.0-rc.3.0.20261030153911-cc2272b3cdd8
